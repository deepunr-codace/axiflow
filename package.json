{
  "name": "web-stream-automation",
  "version": "1.0.0",
  "description": "Mini CRM + end-to-end automation pipeline for a web development service",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "migrate:sqlite": "node --env-file-if-exists=.env scripts/migrate-from-sqlite.js",
    "copy:uploads": "node --env-file-if-exists=.env scripts/copy-uploads-to-supabase.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.14",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.5",
    "express": "^5.1.0",
    "nodemailer": "^7.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  }
}
