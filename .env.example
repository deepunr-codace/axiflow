# ---- Database ----
# Postgres connection string. Empty => embedded Postgres in data/pg (fine for running on your own machine).
# Supabase on Vercel: use the "Transaction pooler" string (Supabase > Connect, port 6543); the direct
# db.<ref>.supabase.co:5432 host is IPv6-only and Vercel cannot reach it.
DATABASE_URL=

# ---- Uploads (images, imported template pages) ----
# Supabase Storage (preferred): project URL + the project's SECRET key (Project Settings > API Keys > Secret keys;
# or the legacy service_role key). Files go to a private bucket, created automatically.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=axiflow-uploads
# Vercel Blob (previous setup; still read for files saved before the switch). Empty + no Supabase => data/uploads.
BLOB_READ_WRITE_TOKEN=

# ---- Scheduler. On Vercel, /api/cron/tick is called by Vercel Cron (daily, see vercel.json) and should be
# called every 15 min by an external pinger: https://<your-app>/api/cron/tick?key=<CRON_SECRET>
CRON_SECRET=change-me-cron-secret

# ---- Server ----
PORT=3000
BASE_URL=http://localhost:3000          # public URL used in links sent to clients
ADMIN_PASSWORD=admin                    # CRM login password - CHANGE IT
SESSION_SECRET=change-me-to-a-long-random-string
INTAKE_API_KEY=change-me-intake-key     # for POST /api/intake (website forms, ads, n8n, Zapier)
WEBHOOK_SECRET=change-me-webhook-secret # for /webhooks/email and /webhooks/payment

# ---- Email (SMTP). Leave SMTP_HOST empty => mock mode (messages go to the Outbox only) ----
# Gmail: smtp.gmail.com / 465 / your address / an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Axilume <hello@axilume.com>"

# ---- WhatsApp Cloud API (Meta). Leave empty => mock mode ----
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=change-me-verify-token
WA_TEMPLATE_LANG=en
WA_API_VERSION=v21.0

# ---- AI (Claude). Set one of these; leave both empty => rule-based pitch/design/follow-ups ----
ANTHROPIC_API_KEY=
# OpenRouter (openrouter.ai): used when ANTHROPIC_API_KEY is empty, or when Settings > AI provider = openrouter
OPENROUTER_API_KEY=

# ---- Sync to the team CRM: every stage change / next action / reply is POSTed here ----
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=change-me-crm-signing-secret   # HMAC-SHA256 of the body, sent as X-WebStream-Signature: sha256=<hex>

# ---- Twenty via n8n (see n8n/README.md) ----
TWENTY_WEBHOOK_SECRET=        # optional: verify Twenty's signature on /webhooks/twenty
